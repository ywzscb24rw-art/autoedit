ANTHROPIC_API_KEY=sk-ant-...
# Whisper model: large-v3-turbo (default, best), small.en, medium.en, large-v3
WHISPER_MODEL=large-v3-turbo
# auto (MLX on Apple Silicon GPU, else CPU), mlx, or cpu
WHISPER_BACKEND=auto
# claude-opus-5-5 (best judgment, esp. clips) or claude-sonnet-5-5 (half the price, fine for clean edits)
CLAUDE_MODEL=claude-opus-5-5
